# ============================================================================
# NEXT.JS ORTAM DEĞİŞKENLERİ
# ----------------------------------------------------------------------------
# Bu değerler Firebase Console > Project Settings > General > Your apps
# bölümünden kopyalanır. `NEXT_PUBLIC_` öneki, Next.js'in değişkenlerin
# tarayıcıya (istemciye) açılmasına izin verir.
#
# GÜVENLİK: `NEXT_PUBLIC_` ile tanımlanan HER ŞEY tarayıcıda görünür.
# Bu nedenle burada ASLA servis hesabı anahtarı, admin SDK anahtarı veya
# Meta APP SECRET bulunmamalıdır. Bu değerler yalnızca `functions/.env`
# içinde ve Firebase Secret Manager'da tutulur.
#
# Bu dosyayı `.env.local` olarak kopyalayın ve `.env.local` commit ETMEYİN.
# ============================================================================

# --- Firebase Web App Yapılandırması -----------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- Uygulama ayarları -------------------------------------------------------
# Dashboard'da gösterilen ürün adı (navbar başlığı).
NEXT_PUBLIC_APP_NAME=InstaFlow

# API kökü. Firebase Hosting + Rewrites kullanıldığında BOŞ bırakılabilir
# (relative path yeterlidir). Ayrı bir domain'de yayın yapılıyorsa tam URL verin.
# Örn: NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_API_BASE_URL=