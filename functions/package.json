{
  "name": "instagram-automation-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud Functions v2 katmanı - Domain / Services / Use-cases / Adapters",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"lib/tests/*.test.js\"",
    "prepare:web": "node scripts/prepare-web.mjs",
    "predeploy": "npm run build",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,hosting",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.1",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "typescript": "^5.6.3"
  }
}