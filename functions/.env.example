# ============================================================================
# FUNCTIONS ORTAM DEĞİŞKENLERİ
# ----------------------------------------------------------------------------
# Bu dosyayı `.env` olarak kopyalayın ve gerçek değerleri girin:
#   functions/.env        → Emulator + yerel geliştirme
#   Firebase Console > Functions > Configuration > Environment variables
#                        → üretim
#
# `.env` dosyası ASLA commit edilmez (.gitignore'da).
# ============================================================================

# --- Firebase ---------------------------------------------------------------
# `firebase use <project>` sonrası `firebase.json`'daki projectId ile AYNI olmalı.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Meta webhook imzası hesaplanırken kullanılan bölge.
# Hosting rewrites ve webhook URL'inde de aynı bölge kullanılmalıdır.
FIREBASE_REGION=europe-west1

# --- Meta / Facebook --------------------------------------------------------
# App ID ve Secret: Meta for Developers > App Settings > Basic
META_APP_ID=your-meta-app-id

# X-Hub-Signature-256 HMAC doğrulaması için ZORUNLU.
# Yanlışsa tüm webhook istekleri 401 döner.
META_APP_SECRET=your-meta-app-secret

# Webhook abonelik doğrulamasında kullandığınız kendi token'ınız.
# Bu değer Meta Dashboard'a girilir ve `hub.verify_token` ile karşılaştırılır.
META_VERIFY_TOKEN=choose-a-long-random-string

# Graph API sürümü (proje standardı: v19.0)
META_GRAPH_VERSION=v19.0

# OPSİYONEL: Demo/smoke testleri için tek bir statik erişim token'ı.
# Üretimde her Instagram hesabı `connections` koleksiyonunda kendi token'ını tutar
# ve webhook işlemesi o token'ı kullanır.
# META_ACCESS_TOKEN=EAAJ...

# --- Uygulama davranışı -----------------------------------------------------
# Log'ların kaç gün saklanacağı (gece 03:00 cron görevi siler).
LOG_RETENTION_DAYS=30

# Meta Graph API istek zaman aşımı (ms)
REQUEST_TIMEOUT_MS=10000

# Tek webhook isteğinde işlenecek azami olay sayısı (bellek koruması)
MAX_EVENTS_PER_REQUEST=50